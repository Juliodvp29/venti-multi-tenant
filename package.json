{
  "name": "venti-multi-tenant",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --disable-warning=DEP0205 node_modules/@angular/cli/bin/ng.js serve",
    "prebuild": "node scripts/set-env.js",
    "build": "node --disable-warning=DEP0205 node_modules/@angular/cli/bin/ng.js build",
    "watch": "node --disable-warning=DEP0205 node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "test": "node --disable-warning=DEP0205 node_modules/@angular/cli/bin/ng.js test",
    "lint": "eslint .",
    "serve:ssr": "node dist/venti-multi-tenant/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-server": "^22.1.4",
    "@angular/router": "^22.1.3",
    "@angular/ssr": "^22.1.7",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.95.3",
    "apexcharts": "^5.6.0",
    "dompurify": "^3.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "marked": "^17.0.3",
    "ng-apexcharts": "^2.0.4",
    "rxjs": "~7.8.0",
    "supabase": "^2.76.9",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.2.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/marked": "^5.0.2",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-rxjs-x": "^1.0.6",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.8"
  }
